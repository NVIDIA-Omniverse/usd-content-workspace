# Environment
.env
.env.*
*.env.example

# Scripts (development only). Nothing under here is needed at runtime.
#
# The chart's queue-policy hook module deliberately does NOT live here: it must
# ship in BOTH the runtime image (the post-install/post-upgrade hook Job runs
# `python -m public_scripts.apply_queue_policy` out of this image, which carries
# app code via `COPY . /code` rather than installing the project) and the public
# source mirror (the published chart references it, and
# `.publishignore.service` drops `scripts/` wholesale as a pure denylist with no
# negation available). Hence the separate top-level `public_scripts/` package,
# which is intentionally excluded neither here nor there.
scripts

# Helm charts (not needed in runtime container)
helm

# Coverage reports
htmlcov/
.coverage

