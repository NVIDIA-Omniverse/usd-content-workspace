{
  "compilerOptions": {
    "types": ["node", "@testing-library/jest-dom", "vitest/globals", "@types/wicg-file-system-access"],
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./",
    "rootDir": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@/test-utils": ["./src/test-utils"]
    }
  },
  "include": ["src", "src/test-utils", "__mocks__"]
}
