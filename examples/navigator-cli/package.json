  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "sn": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --dts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
