    "proper-lockfile": "^4.1.2",
    "radash": "^12.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.9.1",
    "msw": "^2.7.0",
    "prettier": "^3.3.3",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.58.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
