# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
.batchignore
# Existing helm packages
*.tgz
# Common VCS dirs
.git/
.gitattributes
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# CI Pipeline
.gitlab-ci*
.gitlab/
# Dashboards (kept in repo for reference, not deployed by the chart)
files/dashboards/
# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyi
.env
.pytest_cache/
