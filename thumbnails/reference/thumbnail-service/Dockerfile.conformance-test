# Separate top-level Dockerfile, not a stage in docker/Dockerfile: this image is
# published to NGC for customers to run standalone against their own deployment
# (see openspec/changes/archive/2026-09-04-add-conformance-test-suite), an entirely different
# distribution and audience than the service/task-worker images docker/Dockerfile
# builds. Mirrors that file's builder pattern.

FROM rust:1.94 AS builder
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install --no-install-recommends --yes pbzip2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app
COPY crates crates
COPY vendor vendor
COPY proto proto
COPY Cargo.toml .
COPY Cargo.lock .
COPY LICENSE.txt .

RUN cargo build --package thumbnail-conformance-test --release --locked

# Vendor all third-party crates. A compliance artifact, not a build convenience:
# OSRB's low-risk auto-approval is conditional on third-party source-code
# distribution, and this archive is how that obligation is discharged. See
# docs/oss-compliance.md and openspec/specs/oss-license-compliance.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/root/.cache/target \
    --mount=type=bind,source=.,target=/usr/src/app \
    CARGO_TARGET_DIR=/root/.cache/target \
    cargo vendor /root/.cache/vendor --color never --locked --versioned-dirs && \
    mkdir /vendor && \
    tar -cf - /root/.cache/vendor | pbzip2 -c > /vendor/vendor.tar.bz2

# ---------------------------------------------------------------------------
# conformance-test — black-box REST/gRPC contract check, published to NGC for
# customers to run standalone. No API surface of its own.
# ---------------------------------------------------------------------------
# Match the service/worker runtime base; this NGC image permits anonymous pulls.
FROM nvcr.io/nvidia/distroless/cc:v4.1.4 AS conformance-test

LABEL maintainer="NVIDIA"
LABEL org.opencontainers.image.title="Thumbnail Service Conformance Test"
LABEL org.opencontainers.image.description="Black-box REST/gRPC conformance test for a deployed thumbnail-service"
LABEL org.opencontainers.image.vendor="NVIDIA"
LABEL org.opencontainers.image.source="https://github.com/NVIDIA-Omniverse/usd-content-workspace/tree/main/thumbnails/reference/thumbnail-service"

WORKDIR /app

COPY --from=builder /usr/src/app/target/release/thumbnail-conformance-test /app/thumbnail-conformance-test
COPY --from=builder /vendor/vendor.tar.bz2 /app/vendor.tar.bz2
COPY LICENSE.txt .
COPY ATTRIBUTIONS.md .

USER nvs

# All configuration is via CLI flags/env vars — no CMD, no config file.
ENTRYPOINT ["/app/thumbnail-conformance-test"]
