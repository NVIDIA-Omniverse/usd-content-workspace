# =============================================================================
# Thumbnail Service Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control - it contains secrets.
#
# For Kubernetes deployments, use Helm values instead of this file.
# See helm/thumbnail-service/values.yaml for all configuration options.
# =============================================================================

# =============================================================================
# REQUIRED: Thumbnail Sizes
# =============================================================================
# Comma-separated list of `WxH` pairs defining the thumbnail dimensions the
# service produces for every source asset. Required - the service refuses to
# start if this is missing, empty, or malformed.
# Bounds: 1..=4096 per dimension; 1..=10 entries; no duplicates.
# Example for the single legacy size:           THUMBNAIL_SIZES=256x256
# Example for a multi-size deployment:          THUMBNAIL_SIZES=64x64,128x128,256x256
THUMBNAIL_SIZES=256x256

# =============================================================================
# REQUIRED: Service Endpoints
# =============================================================================
# Every endpoint below is reached over plaintext HTTP/2, and an https:// value is
# refused at startup rather than silently downgraded. This build links tonic
# without a TLS feature: TLS terminates at the ingress proxy, the endpoints here
# are cluster-internal, and there is no service mesh. Bearer tokens therefore
# travel in gRPC metadata in the clear between pods -- that is the deployment
# model, not an oversight. Supply a scheme-less or http:// address.
#
# Serving these over TLS is a deliberate change: it needs a tonic tls-* feature,
# chart support, and a certificate story. See helm/thumbnail-service/README.md.

# Storage service for file operations (gRPC)
STORAGE_GRPC_ENDPOINT=localhost:50001

# Event consumer for storage notifications (gRPC) - optional
NOTIFICATIONS_EVENT_CONSUMER_ENDPOINT=localhost:50002

# Event aggregation endpoint, where omni.thumbnail.associated /
# omni.thumbnail.disassociated are published. Unset disables that publishing.
# NOTIFICATIONS_EVENT_AGGREGATION_ENDPOINT=localhost:50003

# REQUIRED BY task-worker: where it calls AssociateThumbnail after uploading.
# No default -- the worker refuses to start without it. The service itself does
# not read this.
THUMBNAIL_SERVICE_GRPC_ENDPOINT=localhost:50051

# =============================================================================
# REQUIRED: Thumbnail Destination Path Template
# =============================================================================
# Template used to resolve one exact, absolute output address per generated
# thumbnail. Replaces the legacy fixed THUMBNAIL_ADDRESS prefix (removed).
# Must identify its source via {resource_address_md5} alone, or both
# {resource_path} and {resource_filename} together, and must render an
# absolute address — the service fails fast at startup otherwise.
# Supported variables: resource_path, resource_filename, resource_address_md5,
# resource_identity_md5, width, height, output_encoding, quality.
# See README.md#thumbnail-destination-path-template for the full variable
# reference and examples.
THUMBNAIL_PATH_TEMPLATE=https://your-storage-account.blob.core.windows.net/your-container/thumbnails/{resource_address_md5}/{width}x{height}/{resource_filename}.auto.{output_encoding}

# Optional principal identity recorded on storage events created by task-worker.
# When unset, the principal-based recursion guard is disabled; template-output
# shape matching remains active. See README.md and docs/adr/0001-thumbnail-storage.md.
# GENERATED_THUMBNAIL_PRINCIPAL_IDENTITY=your-task-worker-writer-principal-id

# =============================================================================
# REQUIRED: Service-identity / outbound auth (in-process client-credentials)
# =============================================================================
# Local-dev always uses the in-process client-credentials flow. The
# sidecar-driven access-token-file flow is k8s-only and configured via Helm
# values, so ENABLE_ACCESS_TOKEN_FILE should not be enabled locally. It is
# listed further down in commented form with the inert value `false`, which is
# what a commented entry means anyway -- uncommenting it changes nothing, and
# the entry is there so the variable is discoverable rather than only mentioned
# in this paragraph.
#
# Token endpoint is resolved at runtime from the OpenID Connect discovery
# document referenced by CLIENT_CREDENTIALS_OPENID_CONFIGURATION. The legacy
# TENANT_ID / TOKEN_URI env vars and the four TOKEN_* tunables
# (TOKEN_EXPIRY_BUFFER_SECONDS, TOKEN_REFRESH_INTERVAL_SECONDS,
# TOKEN_ACQUISITION_TIMEOUT_SECONDS, TOKEN_WAIT_POLL_MS) have been removed.
#
# Register an App in Azure AD to get these values
# See: https://docs.microsoft.com/en-us/azure/active-directory/develop/quickstart-register-app

# Toggle the in-process flow on. Mutually exclusive with ENABLE_ACCESS_TOKEN_FILE.
ENABLE_CLIENT_CREDENTIALS=true

# Application (client) ID from Azure AD app registration
CLIENT_ID=your-client-id-guid

# Client secret from Azure AD app registration
# For production, use CLIENT_SECRET_FILE instead (mount the secret as a file).
CLIENT_SECRET=your-client-secret

# OAuth2 scope - typically {client-id}/.default for client credentials flow
CLIENT_SCOPE=your-client-id-guid/.default

# OpenID Connect discovery endpoint (token_endpoint resolved at runtime)
CLIENT_CREDENTIALS_OPENID_CONFIGURATION=https://login.microsoftonline.com/your-tenant-id-guid/v2.0/.well-known/openid-configuration

# Alternative to CLIENT_SECRET: read the secret from a file instead, which is how
# the chart mounts it from a Kubernetes Secret. Exactly one of the two.
# CLIENT_SECRET_FILE=/etc/secrets/CLIENT_SECRET

# Extra headers and body parameters on the token request, for an identity
# provider that needs them. Comma-separated `key=value` pairs.
# CLIENT_CREDENTIALS_EXTRA_HEADERS=
# CLIENT_CREDENTIALS_EXTRA_BODY_PARAMS=

# Sidecar-provisioned token file, the alternative to the in-process
# client-credentials flow above. Mutually exclusive with
# ENABLE_CLIENT_CREDENTIALS; the deployed dev environment uses this one.
# ENABLE_ACCESS_TOKEN_FILE=false
# ACCESS_TOKEN_FILE_PATH=/var/run/secrets/token
# ACCESS_TOKEN_FILE_POLL_INTERVAL=30s

# =============================================================================
# OPTIONAL: Listener ports (service)
# =============================================================================
# REST listener port.
# PORT=3000

# gRPC listener bind address, host and port together.
# GRPC_PORT=0.0.0.0:50051

# =============================================================================
# OPTIONAL: Listener port (task-worker)
# =============================================================================
# Probe and /metrics port. The worker has no API surface, so this is the only
# listener it opens.
# HEALTH_PORT=8080

# =============================================================================
# OPTIONAL: Event Consumption Configuration
# =============================================================================
# StorageEventQueue's and WorkerEventQueue's ids are each derived at startup from
# NOTIFICATIONS_QUEUE_RESOURCE_PREFIXES by their own binary:
#   thumbnail-service-storage-<sha256 hex of <sorted unique prefixes>>
#   thumbnail-service-worker-<sha256 hex of <sorted unique prefixes>>
# `thumbnail-service-` is a hardcoded literal, the same for every deployment, and
# the storage/worker segment is what keeps the two ids distinct — the digest does
# not include a queue-kind discriminator. So both ids carry the SAME digest when
# both binaries read the same prefix set: matching digests in a queue listing mean
# the two agree, differing digests mean one side's configuration is stale.
# Neither binary reads NOTIFICATIONS_QUEUE_ID — that variable does not exist.

# --- Durable queue self-provisioning (ensure-exists on startup) ---
#
# The assigned event consumer always ensures its durable queue exists on startup
# (there is no opt-out toggle): it calls CreateDurableQueue (create-if-absent)
# before consuming, so the manual create-durable-queue.sh step is optional.
#
# KUBERNETES: use the Helm chart, not this file. Set
# notifications.eventConsumer.resourcePrefixes in your environment values file
# (both StorageEventQueue's and WorkerEventQueue's ids are derived from that same
# prefix set, each by its own binary) — see
# helm/thumbnail-service/README.md#durable-queue-self-provisioning.
#
# Comma-separated list of storage container URL prefixes for queue filters
# (omni.storage.created/deleted on StorageEventQueue; omni.thumbnail.generate on
# WorkerEventQueue). Each prefix becomes one greedy-prefix filter on the single
# durable queue, so one deployment can subscribe across multiple
# buckets/prefixes. REQUIRED for both the assigned server consumer and
# task-worker (no non-empty prefix is a hard startup failure for either). Blank
# slots (e.g. a,,b) are rejected — unlike Helm, which trims/drops blank YAML list
# entries before joining. Use the container root, not a subdirectory like
# .../thumbnails (that path is derived per-request from THUMBNAIL_PATH_TEMPLATE,
# a different concern). Same scope as RESOURCE_PATH in
# scripts-notifications/.env.example.
NOTIFICATIONS_QUEUE_RESOURCE_PREFIXES=https://your-account.blob.core.windows.net/your-container/,https://your-account.blob.core.windows.net/another-container/

# Which server handles event consumption: HTTP or GRPC
# Only one server should consume events to avoid duplicates
EVENT_CONSUMER_SERVER=HTTP

# Set to true to disable event listening entirely
# DISABLE_EVENT_CONSUMPTION=false

# =============================================================================
# REQUIRED: Thumbnail Processing Config
# =============================================================================
# Width and height now come from the REQUIRED `THUMBNAIL_SIZES` env var (top of
# this file). The legacy `THUMBNAIL_DEFAULT_WIDTH` / `THUMBNAIL_DEFAULT_HEIGHT`
# (and the older `DEFAULT_THUMBNAIL_WIDTH` / `DEFAULT_THUMBNAIL_HEIGHT`) keys
# are no longer read by the service.

# Output format: PNG, JPEG, WEBP
THUMBNAIL_ENCODING_FORMAT=PNG

# Transform type: SQUARE, SCALE_BY_WIDTH, SCALE_BY_HEIGHT, CROP, FIT, SCALE_AND_CROP
# FIT matches the chart default: scale the whole source into the requested box
# and pad the remainder, rather than filling the box by discarding the edges.
THUMBNAIL_TRANSFORM_TYPE=FIT

# JPEG quality (1-100)
THUMBNAIL_QUALITY=85

# Preserve aspect ratio when resizing
THUMBNAIL_PRESERVE_ASPECT_RATIO=true

# Crop strategy: CENTER, TOP, BOTTOM, LEFT, RIGHT, TOP_LEFT, TOP_RIGHT, BOTTOM_LEFT, BOTTOM_RIGHT, SMART (default)
THUMBNAIL_CROP_STRATEGY=SMART

# =============================================================================
# OPTIONAL: Storage gRPC channel (service)
# =============================================================================
# Connect and per-request deadlines for the storage channel the metadata path
# uses. The request timeout also bounds the CreateThumbnails source Stat.
# STORAGE_GRPC_CONNECT_TIMEOUT=10s
# STORAGE_GRPC_REQUEST_TIMEOUT=30s

# HTTP/2 and TCP keepalive on that channel. Keepalive notices a peer that has
# gone away; it does not bound a peer that answers and then goes quiet, which is
# what the request timeout above is for.
# STORAGE_GRPC_HTTP2_KEEPALIVE_INTERVAL=30s
# STORAGE_GRPC_KEEPALIVE_TIMEOUT=20s
# STORAGE_GRPC_TCP_KEEPALIVE=300s

# =============================================================================
# OPTIONAL: Storage metadata retries (service)
# =============================================================================
# Retry budget and backoff for storage metadata reads and writes.
# STORAGE_METADATA_MAX_RETRIES=3
# STORAGE_METADATA_INITIAL_DELAY=200ms
# STORAGE_METADATA_MAX_DELAY=2s

# =============================================================================
# OPTIONAL: Outbound deadline (service)
# =============================================================================
# Deadline on the service's own unary outbound calls -- currently the generate
# publish. Per-call rather than on the channel, because the same builder also
# carries the long-lived durable consume stream.
# OUTBOUND_REQUEST_TIMEOUT=30s

# =============================================================================
# OPTIONAL: Retry & Timeout Configuration
# =============================================================================
# Maximum backoff for reconnection attempts
# MAX_RECONNECT_BACKOFF_SECONDS=60

# Maximum transient retry attempts (Unavailable/DeadlineExceeded) the durable-queue
# startup provisioning makes before failing fast. Independent of the reconnect
# backoff cap above. Set to 0 to disable provisioning retries.
# NOTIFICATIONS_PROVISIONING_MAX_RETRIES=4

# First backoff step, doubled per attempt up to the exponent cap and the maximum
# above. Jittered over the upper half of the computed interval so replicas do not
# retry a recovering dependency in lock-step.
# RECONNECT_BASE_BACKOFF_SECONDS=5
# RECONNECT_BACKOFF_EXPONENT_CAP=4

# How long a consume stream may be silent before it is considered stale.
# STREAM_TIMEOUT_SECS=90

# Grace period for in-flight event tasks on shutdown (service).
# TASK_CLEANUP_TIMEOUT_SECS=30

# How long the health surface stays quiet before repeating a warning.
# HEALTH_WARNING_INTERVAL=60s

# Oldest a storage CREATE may be and still be dispatched. Past this the event is
# acknowledged without work, so a long backlog cannot be replayed indefinitely.
# EVENT_TASK_SUBMISSION_MAX_RETRY_AGE=24h

# =============================================================================
# OPTIONAL: Task-worker runtime
# =============================================================================
# Conversions in flight per replica. The memory limit is this times
# MAX_TRANSFORM_PEAK_BYTES plus process overhead, so each one costs a gigabyte of
# ceiling; the HPA buys throughput more cheaply by adding replicas.
# MAX_CONCURRENT_CONVERSIONS=2

# How long a retryably-failed delivery waits before its negative acknowledgement
# is sent, spacing successive attempts at the same work.
# REDELIVERY_RECYCLE_INTERVAL=60s

# Grace period for in-flight conversions on SIGTERM. Conversions still running
# when it expires are aborted.
# SHUTDOWN_DRAIN_TIMEOUT=30s

# Deadline on the worker's outbound calls: storage read, storage write, and the
# AssociateThumbnail call.
# OUTBOUND_REQUEST_TIMEOUT=30s

# =============================================================================
# OPTIONAL: Performance Tuning
# =============================================================================
# Maximum concurrent event processing
# EVENT_PROCESSING_MAX_CONCURRENT=100

# =============================================================================
# OPTIONAL: Durable-queue redelivery (NACK spacing)
# =============================================================================
# A retryable failure is returned to its durable queue by an explicit negative
# acknowledgement. The broker requeues immediately, so the spacing between
# successive attempts at the same work is entirely consumer-side and these three
# values are what set it. All have defaults; no environment needs to set them.
#
# How long a failed delivery's negative acknowledgement is held before being
# sent. Keep it far inside the broker's acknowledgement timeout (1800s in dev),
# and above TASK_CLEANUP_TIMEOUT_SECS is fine — a held NACK is flushed on
# session teardown rather than abandoned.
# NACK_REDELIVERY_DELAY_SECS=60

# Most negative acknowledgements held at once. Held deliveries stay in flight, so
# an unbounded number of them refills the prefetch window and stops delivery.
# Past this bound a failure is negatively acknowledged immediately instead.
# NACK_DEFERRAL_CONCURRENCY_LIMIT=10

# Consecutive early redeliveries of one delivery key before the consume session
# is recycled to force spacing by not being connected. Reached only when the
# broker requeues without honouring the delay.
# NACK_EARLY_REDELIVERY_LIMIT=5

# The task-worker reads the same two bounds, and takes its redelivery delay from
# REDELIVERY_RECYCLE_INTERVAL (default 60s) rather than a separate variable.

# =============================================================================
# OPTIONAL: Conversion bounds (task-worker)
# =============================================================================
# Largest source the worker will download and decode, in bytes.
# MAX_SOURCE_BYTES=67108864

# Largest decoded image the worker will allocate for, in pixels. Bounds the
# decode; MAX_TRANSFORM_PEAK_BYTES below bounds what converting it costs, which
# is the larger number and the one the pod's memory limit is sized against.
# MAX_DECODED_PIXELS=64000000

# Largest peak allocation a single resample may reach, in bytes. Default 1 GiB.
#
# This is what the pod's memory limit is sized against, not MAX_DECODED_PIXELS.
# A resample allocates a working buffer of source_width x new_height at 16 B/px
# on top of the source and the result, and that buffer's width comes from the
# source — so an image well inside the decode bound can still peak in gigabytes
# for a small thumbnail. Exceeding this is a permanent conversion failure, not
# an OOM kill. The Helm chart refuses to render when
# MAX_CONCURRENT_CONVERSIONS x this value + 200Mi exceeds the memory limit.
# MAX_TRANSFORM_PEAK_BYTES=1073741824

# =============================================================================
# OPTIONAL: Cross-origin access (service)
# =============================================================================
# Whether the REST API answers cross-origin requests. Default false.
# ENABLE_CORS=false

# Origins permitted when ENABLE_CORS is true, comma-separated. Default empty,
# which permits none — enabling CORS without naming origins refuses every
# cross-origin request rather than quietly permitting all of them. Only the
# methods the router serves (GET, POST, DELETE, OPTIONS) and the headers a
# caller of this API sends are allowed; neither is configurable.
# CORS_ALLOWED_ORIGINS=https://console.example,https://studio.example

# =============================================================================
# OPTIONAL: Development & Debugging
# =============================================================================
# Local development only -- never set this in a deployed environment.
#
# It makes GET /v1alpha/thumbnails return fabricated data without calling storage
# at all, which means the read path performs no authorization check: any
# bearer-shaped token gets a 200, because the storage call that would have
# enforced access is exactly what is being skipped. There is no auth middleware
# to disable; storage's own permission check is the only authorization the read
# path has.
#
# There is no Helm values field for it and the deployment overlays do not set it,
# so enabling it in a cluster takes a deliberate extraVars entry. task-worker
# parses it and does not act on it.
# DEVELOPMENT_MODE=false

# Service name in traces and metrics. Note the name: SERVICE_NAME is read by
# nothing -- `init_tracing` passes a hardcoded literal and otel-tools resolves the
# resource from OTEL_SERVICE_NAME (or service.name in OTEL_RESOURCE_ATTRIBUTES).
# OTEL_SERVICE_NAME=thumbnail-service

# Rust log level: error, warn, info, debug, trace
# RUST_LOG=info
