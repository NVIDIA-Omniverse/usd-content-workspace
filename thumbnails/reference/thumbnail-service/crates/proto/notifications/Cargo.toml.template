[package]
name = "notifications-proto"
version.workspace = true
authors.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true

[lib]
doctest = false

# `protoc-gen-prost-crate` copies this file over `Cargo.toml` verbatim and appends
# nothing, so dependencies and lint configuration have to live here to survive a
# regeneration. The generated doc comments come from the .proto comment style, which
# trips `clippy::doc_lazy_continuation`; the allowance cannot go inside a generated file.
[dependencies]
prost = { workspace = true }
prost-types = { workspace = true }
tonic = { workspace = true }
tonic-prost = { workspace = true }

[lints.clippy]
doc_lazy_continuation = "allow"
