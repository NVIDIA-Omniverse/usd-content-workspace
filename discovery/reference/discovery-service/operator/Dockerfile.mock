FROM rust:1.97-bookworm AS builder
ARG DEBIAN_FRONTEND="noninteractive"

RUN apt-get update && apt-get install --no-install-recommends --yes protobuf-compiler

WORKDIR /usr/src/app
COPY src src
COPY discovery-protos discovery-protos
COPY build.rs .
COPY Cargo.toml .
COPY Cargo.lock .
COPY LICENSE.txt .
RUN cargo build --release --bin mock-capabilities


FROM nvcr.io/nvidia/distroless/cc:v4.1.6

WORKDIR /app
COPY --from=builder /usr/src/app/target/release/mock-capabilities /app/mock-capabilities
COPY LICENSE.txt .

EXPOSE 50051

USER 1000:1000

CMD ["/app/mock-capabilities"]
